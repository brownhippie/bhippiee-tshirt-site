# Copy to .env for local builds. Never commit .env.

# Same Etsy app you already created for the brand app (reuses it; no new
# Etsy app needed). If you have the brand app connected locally, this script
# reuses its token automatically and you can leave these two blank.
ETSY_CLIENT_ID=
ETSY_SHARED_SECRET=      # only if your Etsy app shows one (sent as keystring:secret)
ETSY_SHOP_NAME=          # your Etsy shop's name -> simple public mode, no login token
ETSY_REFRESH_TOKEN=      # optional fallback only

# Your real GitHub Pages URL once the repo exists, e.g.
# https://yourusername.github.io/bhippiee-tshirt-site
# (or your own custom domain if you add a CNAME). Must be set correctly --
# it's used in canonical tags, sitemap.xml, and structured data.
SITE_URL=https://example.github.io

BRAND_NAME=Resonance Collection
